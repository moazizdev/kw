# Prisma Postgres connection string.
# Copy this file to .env and paste the value from the Prisma Console:
#   Console -> your database -> "Connect to your database"
#
# Keep this value secret. Never commit .env or expose it in browser code.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Optional: direct (non-pooled) connection string used only by migrations.
# If your DATABASE_URL is pooled and `npm run db:migrate` fails, set this to
# the direct connection string and point prisma7.config.ts at it.
# DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
